# ==== Frontend — copie para frontend/.env.local ====
# Somente valores PÚBLICOS: tudo que começa com VITE_ vai para o navegador.
# URL da API. Em desenvolvimento o Vite faz proxy de /api para http://localhost:3333.
VITE_API_URL=/api/v1
# Supabase → Project Settings → API (URL e chave anon/publishable). NUNCA a service_role/secret.
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon
