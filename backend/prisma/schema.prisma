// Modelo de dados da Podium Sports (PostgreSQL / Supabase).
// Valores monetários são inteiros em centavos (sufixo Cents).
// RLS, índices parciais, CHECKs e o bucket do Storage ficam nas migrations SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum InventoryMovementType {
  INITIAL // carga inicial
  IN // entrada de mercadoria
  OUT // saída manual (perda, uso interno, avaria)
  ADJUSTMENT // ajuste de inventário (contagem)
  ORDER_RESERVATION // reserva ao criar pedido
  ORDER_RELEASE // devolução ao cancelar/expirar pedido
}

enum OrderStatus {
  PENDING // aguardando atendimento
  ACCEPTED
  PROCESSING // em separação
  READY // pronto para retirada/envio
  OUT_FOR_DELIVERY // saiu para entrega (somente pedidos com entrega)
  COMPLETED
  CANCELLED
  EXPIRED // abandonado: não houve atendimento dentro do prazo
}

/// Como a mensagem de atualização chegou (ou foi preparada) para o cliente.
enum MessageChannel {
  WHATSAPP_LINK // link wa.me aberto pelo painel: o envio é feito por uma pessoa e não pode ser confirmado pelo sistema
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum DiscountType {
  PERCENTAGE // value = percentual inteiro (1-90)
  FIXED_AMOUNT // value = centavos a descontar
  FIXED_PRICE // value = preço final em centavos
}

model Profile {
  id         String        @id @default(uuid()) @db.Uuid
  authUserId String        @unique @map("auth_user_id") @db.Uuid
  name       String        @db.VarChar(120)
  email      String        @unique @db.VarChar(254)
  role       UserRole      @default(ADMIN)
  status     AccountStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventoryMovements InventoryMovement[]
  statusChanges      OrderStatusHistory[]
  auditLogs          AuditLog[]
  messagesOpened     OrderMessage[]       @relation("OrderMessageOpenedBy")
  messagesConfirmed  OrderMessage[]       @relation("OrderMessageConfirmedBy")

  @@map("profiles")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(80)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  icon        String   @default("dumbbell") @db.VarChar(30)
  colorFrom   String   @default("#44464d") @map("color_from") @db.VarChar(7)
  colorTo     String   @default("#121214") @map("color_to") @db.VarChar(7)
  imagePath   String?  @map("image_path") @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  showOnHome  Boolean  @default(false) @map("show_on_home")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  legacyId       Int?     @unique @map("legacy_id")
  name           String   @db.VarChar(160)
  slug           String   @unique @db.VarChar(180)
  brand          String?  @db.VarChar(80)
  description    String?  @db.VarChar(5000)
  searchText     String   @default("") @map("search_text") @db.VarChar(400) // nome+marca+categoria sem acentos, mantido pela aplicação
  priceCents     Int      @map("price_cents")
  salePriceCents Int?     @map("sale_price_cents")
  categoryId     String   @map("category_id") @db.Uuid
  stockQuantity  Int      @default(0) @map("stock_quantity")
  minStock       Int      @default(0) @map("min_stock")
  isActive       Boolean  @default(true) @map("is_active")
  isFeatured     Boolean  @default(false) @map("is_featured")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  promotions         PromotionProduct[]

  @@index([categoryId])
  @@index([isActive, isFeatured, sortOrder])
  @@index([isActive, createdAt])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  storagePath String   @map("storage_path") @db.VarChar(300)
  altText     String?  @map("alt_text") @db.VarChar(200)
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  mimeType    String   @map("mime_type") @db.VarChar(40)
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int // variação com sinal: positivo entra, negativo sai
  balanceBefore Int                   @map("balance_before")
  balanceAfter  Int                   @map("balance_after")
  reason        String?               @db.VarChar(300)
  orderId       String?               @map("order_id") @db.Uuid
  profileId     String?               @map("profile_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([orderId])
  @@map("inventory_movements")
}

model Banner {
  id                     String    @id @default(uuid()) @db.Uuid
  kicker                 String?   @db.VarChar(80)
  title                  String    @db.VarChar(80)
  highlight              String?   @db.VarChar(80)
  subtitle               String?   @db.VarChar(300)
  imagePath              String?   @map("image_path") @db.VarChar(300)
  icon                   String?   @db.VarChar(30)
  colorFrom              String    @default("#2a2a2e") @map("color_from") @db.VarChar(7)
  colorTo                String    @default("#0b0b0c") @map("color_to") @db.VarChar(7)
  buttonLabel            String?   @map("button_label") @db.VarChar(40)
  buttonUrl              String?   @map("button_url") @db.VarChar(300)
  secondaryButtonLabel   String?   @map("secondary_button_label") @db.VarChar(40)
  secondaryButtonUrl     String?   @map("secondary_button_url") @db.VarChar(300)
  badgeTop               String?   @map("badge_top") @db.VarChar(20)
  badgeMain              String?   @map("badge_main") @db.VarChar(12)
  badgeBottom            String?   @map("badge_bottom") @db.VarChar(20)
  /// Selo promocional (kicker) pode ser ocultado sem perder o texto.
  showKicker             Boolean   @default(true) @map("show_kicker")
  priceOriginalCents     Int?      @map("price_original_cents")
  priceSaleCents         Int?      @map("price_sale_cents")
  showPrices             Boolean   @default(true) @map("show_prices")
  footnote               String?   @db.VarChar(160)
  /// Destino escolhido no painel ({ type: product | category | page | external | whatsapp, ... }).
  /// Nulo nos banners antigos, que continuam usando button_url.
  buttonTarget           Json?     @map("button_target")
  secondaryButtonTarget  Json?     @map("secondary_button_target")
  secondaryButtonEnabled Boolean   @default(true) @map("secondary_button_enabled")
  /// "split": imagem em painel ao lado do texto; "full": foto ocupando todo o banner.
  layout                 String    @default("full") @db.VarChar(10)
  contentAlign           String    @default("left") @map("content_align") @db.VarChar(6)
  /// Escurecimento sobre a foto, 0–90 (%).
  overlay                Int       @default(85)
  /// Enquadramento da foto por dispositivo: { desktop: { mode, x, y, zoom }, mobile: {...} | null }.
  imageFrame             Json?     @map("image_frame")
  imageBg                String?   @map("image_bg") @db.VarChar(7)
  /// Foto opcional só para o celular (ex.: versão vertical/recortada). Nula = usa a foto principal.
  mobileImagePath        String?   @map("mobile_image_path") @db.VarChar(300)
  mobileImageBg          String?   @map("mobile_image_bg") @db.VarChar(7)
  /// Formato e escurecimento só do celular. Nulos = o celular usa layout/overlay do computador.
  mobileLayout           String?   @map("mobile_layout") @db.VarChar(10)
  mobileOverlay          Int?      @map("mobile_overlay")
  sortOrder              Int       @default(0) @map("sort_order")
  isActive               Boolean   @default(true) @map("is_active")
  startsAt               DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt                 DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("banners")
}

model Promotion {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(120)
  description  String?      @db.VarChar(500)
  discountType DiscountType @map("discount_type")
  value        Int
  startsAt     DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime     @map("ends_at") @db.Timestamptz(3)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  products PromotionProduct[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String @map("promotion_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model Order {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @db.VarChar(12)
  idempotencyKey    String          @unique @map("idempotency_key") @db.VarChar(80)
  customerName      String          @map("customer_name") @db.VarChar(120)
  customerPhone     String          @map("customer_phone") @db.VarChar(20)
  fulfillment       FulfillmentType
  addressStreet     String?         @map("address_street") @db.VarChar(160)
  addressNumber     String?         @map("address_number") @db.VarChar(20)
  addressDistrict   String?         @map("address_district") @db.VarChar(100)
  addressCity       String?         @map("address_city") @db.VarChar(100)
  addressComplement String?         @map("address_complement") @db.VarChar(160)
  notes             String?         @db.VarChar(500)
  subtotalCents     Int             @map("subtotal_cents")
  discountCents     Int             @default(0) @map("discount_cents")
  totalCents        Int             @map("total_cents")
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(UNPAID) @map("payment_status")
  whatsappOpenedAt  DateTime?       @map("whatsapp_opened_at") @db.Timestamptz(3)
  acceptedAt        DateTime?       @map("accepted_at") @db.Timestamptz(3)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?         @map("cancel_reason") @db.VarChar(300)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  stockReleasedAt   DateTime?       @map("stock_released_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  messages           OrderMessage[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([paymentStatus, paidAt])
  @@map("orders")
}

model OrderItem {
  id                     String  @id @default(uuid()) @db.Uuid
  orderId                String  @map("order_id") @db.Uuid
  productId              String? @map("product_id") @db.Uuid
  productName            String  @map("product_name") @db.VarChar(160)
  unitPriceCents         Int     @map("unit_price_cents")
  originalUnitPriceCents Int     @map("original_unit_price_cents")
  quantity               Int
  subtotalCents          Int     @map("subtotal_cents")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?      @db.VarChar(300)
  profileId  String?      @map("profile_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Mensagem de atualização preparada para o cliente (uma por pedido e status).
/// Com WHATSAPP_LINK o sistema só sabe que o WhatsApp foi aberto; "confirmedAt" é a declaração
/// manual de quem enviou — não é confirmação de entrega pelo WhatsApp.
model OrderMessage {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  status         OrderStatus
  channel        MessageChannel @default(WHATSAPP_LINK)
  body           String         @db.VarChar(1000)
  openCount      Int            @default(1) @map("open_count")
  openedAt       DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  lastOpenedAt   DateTime       @default(now()) @map("last_opened_at") @db.Timestamptz(3)
  lastOpenedById String?        @map("last_opened_by_id") @db.Uuid
  confirmedAt    DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  confirmedById  String?        @map("confirmed_by_id") @db.Uuid

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lastOpenedBy Profile? @relation("OrderMessageOpenedBy", fields: [lastOpenedById], references: [id], onDelete: SetNull)
  confirmedBy  Profile? @relation("OrderMessageConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([orderId, status])
  @@map("order_messages")
}

model StoreSettings {
  id                   Int      @id @default(1)
  storeName            String   @map("store_name") @db.VarChar(80)
  logoPath             String?  @map("logo_path") @db.VarChar(300)
  whatsappNumber       String   @map("whatsapp_number") @db.VarChar(15)
  phoneDisplay         String?  @map("phone_display") @db.VarChar(30)
  email                String?  @db.VarChar(254)
  address              String?  @db.VarChar(200)
  city                 String?  @db.VarChar(100)
  openingHours         String?  @map("opening_hours") @db.VarChar(300)
  pickupEnabled        Boolean  @default(true) @map("pickup_enabled")
  deliveryEnabled      Boolean  @default(true) @map("delivery_enabled")
  pickupInfo           String?  @map("pickup_info") @db.VarChar(300)
  deliveryInfo         String?  @map("delivery_info") @db.VarChar(300)
  instagramUrl         String?  @map("instagram_url") @db.VarChar(300)
  facebookUrl          String?  @map("facebook_url") @db.VarChar(300)
  tiktokUrl            String?  @map("tiktok_url") @db.VarChar(300)
  whatsappGreeting     String   @map("whatsapp_greeting") @db.VarChar(300)
  orderMessageIntro    String   @map("order_message_intro") @db.VarChar(300)
  orderMessageFooter   String?  @map("order_message_footer") @db.VarChar(300)
  heroIntervalSeconds  Int      @default(6) @map("hero_interval_seconds")
  pendingOrderTtlHours Int      @default(48) @map("pending_order_ttl_hours")
  timezone             String   @default("America/Sao_Paulo") @db.VarChar(60)
  content              Json     @default("{}")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String?  @map("profile_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
