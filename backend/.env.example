# ==== Backend (API) — copie para backend/.env (nunca versione o .env) ====
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Supabase → Project Settings → Database → Connection string
# Pooler em modo sessão (porta 5432) para a aplicação — use o host exibido em "Connect" (aws-0 ou aws-1):
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?connection_limit=5
# Conexão direta/sessão (porta 5432) para migrations:
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Origens autorizadas a chamar a API (separadas por vírgula). Obrigatório em produção.
CORS_ORIGINS=http://localhost:5173
# Quantidade de proxies na frente da API (Render/Railway/Fly = 1). Necessário para o rate limit por IP.
TRUST_PROXY=0

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave secreta (service_role ou sb_secret_...). SOMENTE no backend. Usada para Storage e convites.
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-chave-secreta
# Opcional: segredo JWT legado (HS256). Se vazio, os tokens são validados pelas chaves públicas (JWKS).
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=store-media

# Segredo para os tokens de consulta de pedidos (gere com: openssl rand -base64 48)
ORDER_TOKEN_SECRET=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres
# URL pública da loja (usada no link de convite de administradores)
ADMIN_APP_URL=http://localhost:5173

API_DOCS_ENABLED=true
ORDER_EXPIRATION_INTERVAL_MINUTES=10
RATE_LIMIT_ORDERS_PER_10_MIN=10
RATE_LIMIT_PUBLIC_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=600

# Somente para o seed: estoque provisório dos produtos importados do HTML
SEED_DEFAULT_STOCK=10
